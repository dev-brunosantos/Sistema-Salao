generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

enum Cargos {
  CLIENTE
  ADMIN
  DEV
}

enum TipoPagamento {
  PIX
  CARTAO
  DINHEIRO
}

enum StatusAgendamento {
  PENDENTE
  CONFIRMADO
  CANCELADO
  REAGENDADO
}

enum StatusAtendimento {
  PENDENTE
  INICIADO
  FINALIZADO
}

enum StatusPagamento {
  PENDENTE
  PAGO
}

model Usuario {
  id Int @id @default(autoincrement())
  nome String
  usuario String @unique
  email String @unique
  senha String 
  cargo Cargos @default(ADMIN)

  dataCadastro DateTime @default(now())
  dataAtualizacao DateTime @updatedAt
}

model Cliente {
  id Int @id @default(autoincrement())
  nome String 
  telefone String?
  cargo Cargos @default(CLIENTE)

  dataCadastro DateTime @default(now())
  dataAtualizacao DateTime @updatedAt

  agendamentos Agendamento[]
}

model Servico {
  id Int @id @default(autoincrement())
  nome String @unique
  descricao String?
  duracao Int?
  preco Float

  dataCadastro DateTime @default(now())
  dataAtualizacao DateTime @updatedAt

  agendamentos Agendamento[]
}

model Agendamento {
  id Int @id @default(autoincrement())
  clienteID Int
  servicoID Int 
  data DateTime
  status StatusAgendamento @default(PENDENTE)

  dataCadastro DateTime @default(now())
  dataAtualizacao DateTime @updatedAt

  cliente Cliente @relation(fields: [clienteID], references: [id])
  servico Servico @relation(fields: [servicoID], references: [id])

  atendimento Atendimento?
}

model Atendimento {
  id Int @id @default(autoincrement())
  agendamentoID Int @unique
  status StatusAtendimento @default(PENDENTE)
  statusPagamento StatusPagamento @default(PENDENTE)
  descricao String?

  dataCadastro DateTime @default(now())
  dataAtualizacao DateTime @updatedAt

  agendamento Agendamento @relation(fields: [agendamentoID], references: [id])
  pagamento Pagamento?
}

model Pagamento {
  id Int @id @default(autoincrement())
  atendimentoID Int @unique
  valor Float
  data DateTime @default(now())
  status StatusPagamento @default(PENDENTE)

  atendimento Atendimento @relation(fields: [atendimentoID], references: [id])
}

